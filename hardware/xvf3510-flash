#!/usr/bin/env python3
"""SJ-201 XVF3510-INT SPI slave boot.

Mark II has no I2C expander: --direct is the only path that makes sense.
The upstream script uses Adafruit busio.SPI with no chip-select object.
"Sending complete" therefore does not mean the DSP heard the image.

This rewrite:
  * drives GPIO8 (SPI0 CE0) as a GPIO chip-select (active low)
  * holds RST_N low, BOOT_SEL high, waits, then releases reset
  * bit-reverses each byte (XVF3510 SPI boot ROM is LSB-first)
  * optionally verifies I2C 0x2C and a non-silent I2S capture
"""

from __future__ import annotations

import argparse
import subprocess
import sys
import time
from pathlib import Path

PWR_GPIO = 16
BOOT_SEL_GPIO = 26
RST_N_GPIO = 27
CS_GPIO = 8  # SPI0_CE0_N on the 40-pin header
XMOS_I2C = 0x2C
TAS_I2C = 0x2F
SPI_BLOCK = 4096

REVERSE = [int(f"{b:08b}"[::-1], 2) for b in range(256)]


def sh(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, check=check, text=True, capture_output=True)


def pinctrl_set(spec: str) -> None:
    sh("pinctrl", "set", *spec.split())


def pinctrl_get(gpio: int) -> str:
    return sh("pinctrl", "get", str(gpio)).stdout.strip()


def i2c_present(addr: int) -> bool:
    try:
        from smbus2 import SMBus

        with SMBus(1) as bus:
            bus.read_byte(addr)
        return True
    except OSError:
        return False
    except Exception:
        # some adapters NAK read_byte but ack a register read
        try:
            from smbus2 import SMBus

            with SMBus(1) as bus:
                bus.read_byte_data(addr, 0)
            return True
        except Exception:
            return False


def capture_nonzero(seconds: float = 1.0) -> tuple[bool, str]:
    wav = Path("/tmp/xvf3510-verify.wav")
    r = subprocess.run(
        [
            "arecord",
            "-D",
            "hw:1,1",
            "-f",
            "S32_LE",
            "-c",
            "2",
            "-r",
            "48000",
            "-d",
            str(int(seconds)),
            str(wav),
        ],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0 or not wav.exists():
        return False, f"arecord failed: {r.stderr.strip() or r.returncode}"
    import array
    import wave

    with wave.open(str(wav), "rb") as w:
        n, ch, sw = w.getnframes(), w.getnchannels(), w.getsampwidth()
        raw = w.readframes(n)
    if sw != 4:
        return False, f"unexpected sampwidth {sw}"
    samples = array.array("i")
    samples.frombytes(raw)
    uniq = len(set(samples))
    nz = sum(1 for s in samples if s != 0)
    msg = f"frames={n} ch={ch} unique={uniq} nonzero={nz}/{len(samples)}"
    return nz > 0 and uniq > 4, msg


class GpioOut:
    def __init__(self, gpio: int, high: bool) -> None:
        self.gpio = gpio
        pinctrl_set(f"{gpio} op {'dh' if high else 'dl'}")

    def set(self, high: bool) -> None:
        pinctrl_set(f"{self.gpio} op {'dh' if high else 'dl'}")

    def input(self) -> None:
        pinctrl_set(f"{self.gpio} ip")


def open_spi(speed_hz: int, mode: int):
    import spidev

    spi = spidev.SpiDev()
    spi.open(0, 0)
    spi.max_speed_hz = speed_hz
    spi.mode = mode
    spi.bits_per_word = 8
    try:
        spi.no_cs = True
    except Exception as e:
        print(f"warning: could not set SPI_NO_CS ({e}); kernel may still wiggle CE0")
    return spi


def xfer_block(spi, cs: GpioOut, block: bytes) -> None:
    cs.set(False)  # active low
    # spidev has a 4096-byte xfer limit on some kernels; write in 4096 anyway
    mv = memoryview(block)
    step = 4096
    for off in range(0, len(block), step):
        spi.writebytes(list(mv[off : off + step]))
    cs.set(True)


def send_image(
    bin_path: Path,
    speed_hz: int,
    mode: int,
    rst_hold_s: float,
    rst_release_s: float,
    pll_pause_s: float,
    block_pause_s: float,
    cs_held: bool,
    verbose: bool,
) -> None:
    data = bin_path.read_bytes()
    print(f'Read file "{bin_path}" size: {len(data)} Bytes')
    print(f"SPI {speed_hz} Hz mode={mode} cs_held={cs_held}")

    pwr = GpioOut(PWR_GPIO, True)
    cs = GpioOut(CS_GPIO, True)
    rst = GpioOut(RST_N_GPIO, True)
    boot = GpioOut(BOOT_SEL_GPIO, False)

    spi = open_spi(speed_hz, mode)
    try:
        # Power already high. Hold in reset, select SPI slave boot.
        rst.set(False)
        boot.set(True)
        cs.set(True)
        time.sleep(rst_hold_s)
        rst.set(True)
        time.sleep(rst_release_s)
        print(f"reset released; {pinctrl_get(BOOT_SEL_GPIO)}; {pinctrl_get(RST_N_GPIO)}; {pinctrl_get(CS_GPIO)}")

        if cs_held:
            cs.set(False)

        for i in range(0, len(data), SPI_BLOCK):
            chunk = bytes(REVERSE[b] for b in data[i : i + SPI_BLOCK])
            n = i // SPI_BLOCK
            if verbose:
                print(f"Sending {len(chunk)} Bytes in block {n} checksum 0x{sum(chunk):X}")
            if cs_held:
                spi.writebytes(list(chunk))
            else:
                xfer_block(spi, cs, chunk)
            if n == 0:
                if cs_held:
                    cs.set(True)
                time.sleep(pll_pause_s)
                if cs_held:
                    cs.set(False)
            elif i + SPI_BLOCK < len(data):
                time.sleep(block_pause_s)

        if cs_held:
            cs.set(True)
    finally:
        spi.close()
        cs.set(True)
        # release BOOT_SEL with no pull so the chip can hold it
        sh("pinctrl", "set", "26", "ip", "pn")
        rst.set(True)
        pwr.set(True)

    print("Sending complete")


def main() -> int:
    p = argparse.ArgumentParser(description="XVF3510-INT SPI slave boot (Mark II / SJ-201)")
    p.add_argument("bin_filename")
    p.add_argument("--direct", action="store_true", help="ignored; Mark II is always direct GPIO")
    p.add_argument("--verbose", action="store_true")
    p.add_argument("--max-spi-speed-mhz", type=float, default=5.0)
    p.add_argument("--spi-mode", type=int, default=0, choices=(0, 1, 2, 3))
    p.add_argument("--block-transfer-pause-ms", type=float, default=1.0)
    p.add_argument("--rst-hold-ms", type=float, default=100.0)
    p.add_argument("--rst-release-ms", type=float, default=100.0)
    p.add_argument("--pll-pause-ms", type=float, default=100.0)
    p.add_argument("--cs-held", action="store_true", help="hold CS low for the whole image (except PLL pause)")
    p.add_argument("--verify", action="store_true", help="check I2C 0x2C and capture after boot")
    p.add_argument("--verify-wait-s", type=float, default=2.0)
    args = p.parse_args()

    bin_path = Path(args.bin_filename)
    if not bin_path.is_file():
        print(f"Error: input file {bin_path} not found", file=sys.stderr)
        return 1

    t0 = time.time()
    send_image(
        bin_path,
        speed_hz=int(args.max_spi_speed_mhz * 1_000_000),
        mode=args.spi_mode,
        rst_hold_s=args.rst_hold_ms / 1000.0,
        rst_release_s=args.rst_release_ms / 1000.0,
        pll_pause_s=args.pll_pause_ms / 1000.0,
        block_pause_s=args.block_transfer_pause_ms / 1000.0,
        cs_held=args.cs_held,
        verbose=args.verbose,
    )
    if args.verbose:
        print(f"Sending image took {time.time() - t0:.3f} seconds")

    if not args.verify:
        return 0

    time.sleep(args.verify_wait_s)
    # I2S clocks must be running or the XVF3510 ignores I2C.
    ok, cap = capture_nonzero(1.0)
    print(f"capture: {cap}")
    xmos = i2c_present(XMOS_I2C)
    tas = i2c_present(TAS_I2C)
    print(f"I2C TAS5806 0x{TAS_I2C:02x}: {'yes' if tas else 'no'}")
    print(f"I2C XVF3510 0x{XMOS_I2C:02x}: {'yes' if xmos else 'no'}")
    if xmos:
        print("VERIFY ok (XMOS I2C 0x2C present)")
        if not ok:
            print("note: raw hw:1,1 capture skipped or silent (often busy under PipeWire)")
        return 0
    print("VERIFY failed (no I2C 0x2C — DSP did not boot)", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
